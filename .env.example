# Local Docker development only. Copy to .env; do not use production credentials.
# Generate a random SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=local-development-only-change-me
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Optional development API keys. Empty values allow local startup.
OPENWEATHERMAP_API_KEY=
CARTO_BASEMAP_API_KEY=

# Compose selects db:5432/stayandtrek and DEBUG=1 explicitly.
# Do not add Cloud SQL credentials: the local stack does not need them.
